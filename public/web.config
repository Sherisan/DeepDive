<?xml version="1.0" encoding="utf-8"?>
<!-- IIS answers 404 for extensions it has no MIME type for, and .webp is not registered by default. -->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- The remove stops a duplicate-entry 500 if the server ever registers .webp itself. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
